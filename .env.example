# --- Обовʼязково ---
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-telegram-token
# Безкоштовний ключ Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# --- Необовʼязково ---
# Який ШІ використовувати: gemini (безкоштовно) або claude (платно, див. DEPLOY.md)
AI_PROVIDER=gemini
# Модель Gemini. gemini-flash-latest — завжди найновіша Flash з безкоштовного тарифу.
# Якщо впираєшся в ліміти — спробуй gemini-flash-lite-latest (ліміти вищі).
GEMINI_MODEL=gemini-flash-latest
# Лише для AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Хто може користуватися ботом (Telegram ID через кому). Порожньо = всі.
# Свій ID дізнаєшся, якщо вписати тут будь-яке число і написати боту — він покаже твій ID.
ALLOWED_USERS=
# Ліміт запитів до ШІ на одного користувача на день
DAILY_AI_LIMIT=40
# Часовий пояс і час нагадувань
TIMEZONE=Europe/Kyiv
LUNCH_REMINDER_HOUR=14
EVENING_SUMMARY_HOUR=21
# Де зберігати базу даних
DB_PATH=data/bot.db
